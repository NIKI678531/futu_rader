# Never bake local credentials or developer databases into backend/worker images.
.env
**/.env*
**/*.env
.git
*.db
*.db-wal
*.db-shm

# Local build/test artifacts are not image inputs.
**/.venv
**/__pycache__
**/.pytest_cache
**/node_modules
**/node_modules.stale-*
**/dist
**/tests
**/*.db
**/*.db-wal
**/*.db-shm
**/*.sqlite*
**/*.sql
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/.aws
**/.ssh
**/*credentials*
**/*secret*.yaml
.scratch
k8s
deploy/kubernetes
deploy/airflow
docs
output
.playwright-cli
