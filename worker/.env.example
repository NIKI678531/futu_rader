# 复制为 worker/.env 后按需改动；.env 已被 .gitignore 排除。
TZ=Asia/Hong_Kong
WORKER_HEARTBEAT_INTERVAL_SECONDS=60

# MarketInsight 只读源库。生产由 Airflow/Kubernetes Secret 注入；不要放在 DAG 参数里。
MARKET_INSIGHT_DATABASE_URL=

# 回看窗口：超出这个天数的数据库同步断点视为过期，从窗口下沿重新开始。
LOOKBACK_DAYS=60

# 瘦库连接串。留空＝本机 SQLite（%LOCALAPPDATA%\futu-radar\radar.db）。
# 生产（compose 内）：mysql+pymysql://radar:radar@mysql:3306/futu_radar?charset=utf8mb4
RADAR_DB_URL=

# 一次性 SQLite → MySQL 迁移工具使用；生产运行时不需要保留。
SOURCE_RADAR_DB_URL=
RADAR_TARGET_DB_URL=

# 一次性导入用（jobs/import_dump.py）。dump 含真实用户昵称／IP 归属地／个人简介，
# **不要**放进仓库树，也不要把路径以外的内容贴进 issue（ADR-0008）。
DUMP_PATH=


# ── AI 标注（ADR-0017、runbook §6.2） ─────────────────────────────────────
#
# 本文件是模板，**密钥字段永久留空**。真实值只写进 worker/.env（已 gitignore）或
# 生产 Secret Manager。任何 `VITE_` 前缀的变量都会被打进前端包发到浏览器，
# 所以这里一个都不许带那个前缀。

AI_PRIMARY_PROVIDER=openai_compatible
AI_PRIMARY_BASE_URL=
AI_PRIMARY_API_KEY=
# 必须是 /models 返回的精确 id，不要按产品宣传名猜（runbook §6.3）。
AI_PRIMARY_MODEL=
# 通过校准门禁的 JSON：生产 Secret 直接放完整 JSON；本地也可填只读文件路径。
AI_CALIBRATION_REPORT=
# 由 scripts.evaluate_gold 生成、通过 400 条人工金标门槛且绑定当前 v3 策略的 JSON。
# 自动分析缺失此报告或报告与当前 model/prompt/schema/taxonomy 不一致时 fail closed。
AI_QUALITY_REPORT=
# 自动 AI 的数据治理硬门；仅在 ADR-0017/0019 前置条件获批后显式设为 true。
# 留空、false 或任何非 true/false 值都会 fail closed；这不是人工结果发布门。
AI_DATA_GOVERNANCE_APPROVED=false
# 切换 provider 时保护历史展示：只补缺失 kind，不 supersede 已有标注。
AI_FILL_MISSING_ONLY=false

AI_REQUEST_TIMEOUT_SECONDS=120
AI_MAX_RETRIES=3
AI_MICRO_BATCH_SIZE=5
AI_MAX_INPUT_TOKENS=8000
AI_CONCURRENCY=2

# Prompt / 标签体系 / Schema 三个版本号都会进入 input_hash；这里必须填写注册表中明确兼容
# 的组合，不能靠相同尾号猜测（runbook §11.3）。
# comment-product-v3 沿用 taxonomy/schema v2 的七维结构，但将产品唯一标识与
# family/underlying 上下文词分离。
# 回放历史影子结果或做 v1/v2/v3 对照实验时才改回旧版本。
AI_PROMPT_VERSION=comment-product-v3
AI_TAXONOMY_VERSION=v2
AI_SCHEMA_VERSION=v2

FMP_BASE_URL=https://financialmodelingprep.com/stable
FMP_API_KEY=

AI_STRUCTURED_OUTPUT=true
# 推理档位：minimal|low|medium|high。批量分类用 low（reasoning token 计费但不出现在输出里）。
AI_REASONING_EFFORT=low
# 供应商是否留存请求。默认 false —— 库里是真实用户评论，没理由多留一份在我们不控制的日志里。
AI_STORE=false
# OpenAI `service_tier`：留空＝不带；`flex`＝Batch 价、同步接口、可能 429 需重试。
# 网关是否透传要先跑 `python -m scripts.probe_gateway` 探明，别猜。
AI_SERVICE_TIER=

# Hugging Face（挂起：ADR-0020 决定 90 天试点只用 LLM，不引入本地模型）。
HF_TOKEN=
HF_HOME=
