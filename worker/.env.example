# 复制为 worker/.env 后按需改动；.env 已被 .gitignore 排除。
TZ=Asia/Hong_Kong
COLLECT_INTERVAL_SECONDS=60

# 采集源凭据。**不要**把真实 token 写进 .env.example 或提交进仓库。
SOURCE_API_BASE=
SOURCE_API_TOKEN=

# 回看窗口：超出这个天数的断点视为过期，从窗口下沿重新开始（见 jobs/collect.py）。
LOOKBACK_DAYS=60

# ClickHouse。compose 内跑时 HOST 改成服务名 clickhouse、PORT 用容器内的 9000。
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=9008
CLICKHOUSE_DB=futu_radar
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
