{
  "name": "futu-radar",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:remote": "node scripts/dev.mjs --remote",
    "build": "webpack --config webpack.config.cjs --mode production",
    "build:vite": "vite build",
    "preview": "vite preview --base /remote/opinion-radar/",
    "preview:vite": "vite preview",
    "remote-smoke": "node scripts/remote-entry-smoke.mjs",
    "unit": "node --test tests/*.test.mjs",
    "design": "vite --config vite.design.config.js",
    "diff": "node scripts/screen-diff.mjs",
    "six-state": "node scripts/six-state.mjs",
    "guards": "node scripts/guards.mjs",
    "test": "npm run unit && npm run guards && npm run six-state && npm run diff",
    "real-data-check": "node scripts/real-data-check.mjs",
    "progress-check": "node scripts/progress-drawer-check.mjs",
    "mock-progress": "node scripts/mock-progress-server.mjs",
    "mirror": "node scripts/mirror.mjs",
    "mirror:test": "node scripts/mirror.mjs --test"
  },
  "dependencies": {
    "opencc-js": "^1.4.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@babel/preset-env": "^7.28.3",
    "@babel/preset-react": "^7.27.1",
    "@vitejs/plugin-react": "^4.3.4",
    "babel-loader": "^9.2.1",
    "css-loader": "^7.1.2",
    "html-webpack-plugin": "^5.6.4",
    "playwright": "^1.49.1",
    "postcss": "^8.5.6",
    "postcss-loader": "^8.1.1",
    "postcss-prefix-selector": "^2.1.1",
    "style-loader": "^4.0.0",
    "vite": "^6.0.7",
    "webpack": "^5.99.8",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.2"
  }
}
