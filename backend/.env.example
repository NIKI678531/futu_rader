# 复制为 backend/.env 后按需改动；.env 已被 .gitignore 排除。
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8008

# 反代子路径（plan.md Q6）。留空＝无前缀；例：/remote/futu-radar
ROOT_PATH=

# 数据源（ADR-0001）：
#   demo —— 仅供显式回归测试／设计验收，不用于日常服务
#   sql  —— 取数自真实瘦库（本地 SQLite / 生产 MySQL）
DATA_PROVIDER=sql

# 瘦库连接串。留空＝本机 SQLite，落在 %LOCALAPPDATA%\futu-radar\radar.db
# （为什么不放仓库里：P: 是网络盘，且库里有真实用户昵称／IP 归属地，见 radar_db/__init__.py）。
# 生产（compose 内）：mysql+pymysql://radar:radar@mysql:3306/futu_radar?charset=utf8mb4
RADAR_DB_URL=

# 管理后台（/admin）。令牌只由管理员输入并保存在浏览器 sessionStorage。
ADMIN_API_TOKEN=

# MarketInsight 只读连接：仅用于核验并选择最新完整 comments_all 回执。
MARKET_INSIGHT_DATABASE_URL=

# Airflow Stable REST API。凭据只保存在后端 Secret，不会返回浏览器。
AIRFLOW_API_BASE_URL=https://airflow.example.internal
AIRFLOW_API_TOKEN=
AIRFLOW_SYNC_DAG_ID=futu_radar_sync
AIRFLOW_ANALYZE_DAG_ID=futu_radar_ai_analysis
ADMIN_HTTP_TIMEOUT_SECONDS=5

# AI 管理闸门；三个值缺一时后台不会允许触发 AI DAG。
AI_DATA_GOVERNANCE_APPROVED=false
AI_CALIBRATION_REPORT=
AI_QUALITY_REPORT=
AI_PRIMARY_MODEL=
AI_PROMPT_VERSION=comment-product-v3
AI_SCHEMA_VERSION=v2
AI_TAXONOMY_VERSION=v2
AI_MICRO_BATCH_SIZE=5
AI_MAX_INPUT_TOKENS=8000
AI_MAX_PAYLOAD_BYTES=12288
AI_MAX_OUTPUT_TOKENS=8192
