# 复制为 backend/.env 后按需改动；.env 已被 .gitignore 排除。
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8008

# 反代子路径（plan.md Q6）。留空＝无前缀；例：/remote/futu-radar
ROOT_PATH=

# ClickHouse。宿主机端口比 ChatInsight 高一位，两个项目可同时跑（plan.md Q3）。
# 在 compose 内跑时 HOST 改成服务名 clickhouse、PORT 用容器内的 9000。
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=9008
CLICKHOUSE_DB=futu_radar
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
